# Copie para .env (desenvolvimento) ou cadastre em Variables no Railway (produção).
# NUNCA versione o arquivo .env nem coloque credenciais reais neste exemplo.

# --- Núcleo -----------------------------------------------------------------
# 1 = desenvolvimento (aceita SQLite se DATABASE_URL estiver vazio). Produção: 0.
DJANGO_DEBUG=0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Domínios separados por vírgula (o domínio *.up.railway.app é incluído automaticamente).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens HTTPS confiáveis para CSRF, ex.: https://gestao.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL pública usada em links de e-mail (padrão: domínio do Railway).
SITE_URL=
PLATFORM_NAME=FrenzelTech Ecommerce

# --- Banco de dados (PostgreSQL) --------------------------------------------
# No Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://usuario:senha@localhost:5432/gestao_saas
DB_CONN_MAX_AGE=60

# --- SUPER ADMIN inicial (opcional; remova a senha após o primeiro acesso) ---
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FULL_NAME=

# --- E-mail (recuperação de senha e convites) --------------------------------
# Sem EMAIL_HOST, os e-mails são exibidos no console (desenvolvimento).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=nao-responda@seudominio.com.br

# --- Armazenamento persistente de imagens (S3-compatible) -------------------
# Railway Bucket, Cloudflare R2 ou AWS S3. Sem bucket, uploads vão para o disco local
# (efêmero no Railway — só use com Railway Volume + SERVE_MEDIA_FROM_DISK=1).
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ADDRESSING_STYLE=virtual
S3_URL_EXPIRE=3600
SERVE_MEDIA_FROM_DISK=0
MEDIA_ROOT=

# --- Segurança e desempenho --------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=2592000
SESSION_COOKIE_AGE=43200
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW=3600
# Obrigatório com mais de uma réplica (limites de tentativa compartilhados).
REDIS_URL=
WEB_CONCURRENCY=3
LOG_LEVEL=INFO
